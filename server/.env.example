# ==========================================
# WEXA TALENT EXPLORER CONFIGURATION
# ==========================================

# 1. Express API Server configuration
PORT=5000
NODE_ENV=development

# 2. JWT Configuration (Secret used to sign session cookies/tokens)
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# 3. CognoDB / Neo4j Database Connection
# Connect using the Bolt protocol. Works out-of-the-box with CognoDB Cloud.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=cognodb
NEO4J_PASSWORD=password
